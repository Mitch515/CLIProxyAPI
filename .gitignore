# Binaries
cli-proxy-api
*.exe

# Configuration
config.yaml
.env

# Generated content
bin/*
logs/*
conv/*
temp/*
refs/*

# Storage backends
pgstore/*
gitstore/*
objectstore/*

# Static assets
static/*

# Authentication data
auths/*
!auths/.gitkeep

# Documentation
docs/*
AGENTS.md
CLAUDE.md
GEMINI.md

# Tooling metadata
.vscode/*
.codex/*
.claude/*
.gemini/*
.serena/*
.agent/*
.agents/*
.agents/*
